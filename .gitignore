# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code local runtime state
.claude/

# workaround local pra disco cheio no C: — específico desta máquina, não deve
# ir pro repo (força um path de cache que não existe em outro ambiente)
.npmrc

# material de referência visual (não é parte do produto)
UX estudo/

# credenciais anotadas localmente pra facilitar acesso — nunca deve ir pro repo
acessos.txt
*.log
